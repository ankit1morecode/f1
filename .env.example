# MongoDB connection used by the API routes under src/routes/api/.
# Defaults to a local mongod if unset.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=slipstream-x

# ImageKit — driver photo uploads.
# The private key signs upload tokens server-side and must NEVER be exposed to
# the browser (no VITE_ prefix, never returned from an API route).
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
